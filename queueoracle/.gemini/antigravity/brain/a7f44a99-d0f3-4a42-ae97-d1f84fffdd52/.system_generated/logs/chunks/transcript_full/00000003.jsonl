-label small fw-bold\">1. Inject Burst Patient Arrivals:</label>\n                                <div class=\"btn-group w-100\">\n                                    <button class=\"btn btn-outline-primary btn-sm\" onclick=\"simBurstArrival(5, 'Normal')\">+5 Normal Patients</button>\n                                    <button class=\"btn btn-outline-primary btn-sm\" onclick=\"simBurstArrival(10, 'Normal')\">+10 Normal Patients</button>\n                                    <button class=\"btn btn-outline-danger btn-sm\" onclick=\"simBurstArrival(3, 'Emergency')\">+3 Emergency Patients</button>\n                                </div>\n                            </div>\n\n                            <div class=\"mb-3\">\n                                <label class=\"form-label small fw-bold\">2. Dynamic Delay Recalculation (Section 5):</label>\n                                <div class=\"btn-group w-100\">\n                                    <button class=\"btn btn-outline-warning btn-sm\" onclick=\"simDoctorDelay(15)\">+15 Mins Delay</button>\n                                    <button class=\"btn btn-outline-danger btn-sm\" onclick=\"simDoctorDelay(30)\">+30 Mins Delay</button>\n                                    <button class=\"btn btn-outline-success btn-sm\" onclick=\"simDoctorDelay(-10)\">-10 Mins (Early)</button>\n                                </div>\n                                <small class=\"text-muted d-block mt-1\">Cascades delay / early offset across subsequent queued patients.</small>\n                            </div>\n\n                            <div class=\"mb-3\">\n                                <label class=\"form-label small fw-bold\">3. Consultation Status Transitions:</label>\n                                <div class=\"d-flex gap-2\">\n                                    <button class=\"btn btn-success btn-sm flex-grow-1\" onclick=\"simCompleteCurrentConsultation()\">\n                                        <i class=\"fas fa-check-circle\"></i> Complete Current Consultation\n                                    </button>\n                                    <button class=\"btn btn-secondary btn-sm\" onclick=\"simToggleDoctorAvail()\">\n                                        <i class=\"fas fa-coffee\"></i> Toggle Doctor Break\n                                    </button>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- Ward & Epidemiological Perturbations -->\n                    <div class=\"col-lg-6\">\n                        <div class=\"card-widget h-100\">\n                            <h5 class=\"widget-title mb-3\"><i class=\"fas fa-hospital\"></i> Ward Bed, Disease & Supply Simulator</h5>\n\n                            <div class=\"mb-3\">\n                                <label class=\"form-label small fw-bold\">Target Department Ward:</label>\n                                <select id=\"simSelectBedDept\" class=\"form-select form-select-sm\">\n                                    <option value=\"Cardiology\">Cardiology Ward (High Occupancy)</option>\n                                    <option value=\"General Medicine\">General Medicine Ward</option>\n                                    <option value=\"Emergency\">Emergency Trauma Unit</option>\n                                    <option value=\"Pediatrics\">Pediatrics Ward</option>\n                                    <option value=\"Orthopedics\">Orthopedics Ward</option>\n                                    <option value=\"General Surgery\">General Surgery Ward</option>\n                                </select>\n                            </div>\n\n                            <div class=\"mb-3\">\n                                <label class=\"form-label small fw-bold\">1. Bed Capacity & Overflow Simulation:</label>\n                                <div class=\"btn-group w-100\">\n                                    <button class=\"btn btn-outline-danger btn-sm\" onclick=\"simBedAdmission()\">\n                                        <i class=\"fas fa-bed\"></i> Simulate Admission (+1 Bed)\n                                    </button>\n                                    <button class=\"btn btn-outline-success btn-sm\" onclick=\"simBedDischarge()\">\n                                        <i class=\"fas fa-door-open\"></i> Simulate Discharge (-1 Bed)\n                                    </button>\n                                </div>\n                            </div>\n\n                            <div class=\"mb-3\">\n                                <label class=\"form-label small fw-bold\">2. Disease Outbreak Surge (Section 7):</label>\n                                <div class=\"btn-group w-100\">\n                                    <button class=\"btn btn-outline-danger btn-sm\" onclick=\"simDiseaseOutbreak('Dengue', 15)\">\n                                        <i class=\"fas fa-mosquito\"></i> +15 Dengue Surge\n                                    </button>\n                                    <button class=\"btn btn-outline-warning btn-sm\" onclick=\"simDiseaseOutbreak('Malaria', 10)\">\n                                        <i class=\"fas fa-virus\"></i> +10 Malaria Surge\n                                    </button>\n                                </div>\n                                <small class=\"text-muted d-block mt-1\">Triggers diagnostic kit depletion warnings and preparedness alerts.</small>\n                            </div>\n\n                            <div class=\"mb-3\">\n                                <label class=\"form-label small fw-bold\">3. Emergency Supply Depletion (Section 10):</label>\n                                <div class=\"d-flex gap-2\">\n                                    <button class=\"btn btn-outline-danger btn-sm flex-grow-1\" onclick=\"simDepleteInventory(1, 10)\">\n                                        <i class=\"fas fa-box-open\"></i> Drain Dengue Kits (to 10)\n                                    </button>\n                                    <button class=\"btn btn-outline-danger btn-sm flex-grow-1\" onclick=\"simDepleteInventory(4, 15)\">\n                                        <i class=\"fas fa-bottle-droplet\"></i> Drain IV Saline (to 15)\n                                    </button>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </section>\n\n            <!-- ========================================================================= -->\n            <!-- 13. ML PERFORMANCE SECTION -->\n            <!-- ========================================================================= -->\n            <section id=\"section-ml-performance\" class=\"dashboard-section\">\n                <div class=\"d-flex justify-content-between align-items-center mb-3\">\n                    <div>\n                        <h4 class=\"fw-bold text-navy mb-0\">Machine Learning Evaluation & Explainability (Section 16)</h4>\n                        <p class=\"text-muted small mb-0\">Real calculated validation metrics on synthetic hospital OPD test split.</p>\n                    </div>\n                    <small class=\"text-muted\">Trained at: <span id=\"mlTrainedAt\" class=\"fw-bold\">--</span></small>\n                </div>\n\n                <div class=\"row g-3 mb-4\">\n                    <!-- Random Forest Card -->\n                    <div class=\"col-md-6\">\n                        <div class=\"card-widget border-primary h-100\">\n                            <div class=\"d-flex justify-content-between align-items-center mb-3\">\n                                <h5 class=\"fw-bold text-primary mb-0\"><i class=\"fas fa-tree\"></i> Random Forest Regressor (Tuned)</h5>\n                                <span class=\"badge bg-primary\">Primary Model</span>\n                            </div>\n                            <div class=\"row g-3\">\n                                <div class=\"col-4 text-center p-2 bg-light rounded\">\n                                    <small class=\"text-muted d-block\">MAE</small>\n                                    <strong class=\"fs-4 text-dark\" id=\"rfMae\">--</strong>\n                                    <div class=\"small text-muted\">Mean Absolute Error</div>\n                                </div>\n                                <div class=\"col-4 text-center p-2 bg-light rounded\">\n                                    <small class=\"text-muted d-block\">RMSE</small>\n                                    <strong class=\"fs-4 text-dark\" id=\"rfRmse\">--</strong>\n                                    <div class=\"small text-muted\">Root Mean Squared</div>\n                                </div>\n                                <div class=\"col-4 text-center p-2 bg-light rounded\">\n                                    <small class=\"text-muted d-block\">R-Squared (R²)</small>\n                                    <strong class=\"fs-4 text-success\" id=\"rfR2\">--</strong>\n                                    <div class=\"small text-muted\">Variance Explained</div>\n                                </div>\n                            </div>\n                            <p class=\"small text-muted mt-3 mb-0\" id=\"mlExplanation\">--</p>\n                        </div>\n                    </div>\n\n                    <!-- Linear Regression Baseline Card -->\n                    <div class=\"col-md-6\">\n                        <div class=\"card-widget h-100\">\n                            <div class=\"d-flex justify-content-between align-items-center mb-3\">\n                                <h5 class=\"fw-bold text-secondary mb-0\"><i class=\"fas fa-chart-line\"></i> Multiple Linear Regression</h5>\n                                <span class=\"badge bg-secondary\">Baseline Benchmark</span>\n                            </div>\n                            <div class=\"row g-3\">\n                                <div class=\"col-4 text-center p-2 bg-light rounded\">\n                                    <small class=\"text-muted d-block\">MAE</small>\n                                    <strong class=\"fs-4 text-dark\" id=\"linearMae\">--</strong>\n                                    <div class=\"small text-muted\">Mean Absolute Error</div>\n                                </div>\n                                <div class=\"col-4 text-center p-2 bg-light rounded\">\n                                    <small class=\"text-muted d-block\">RMSE</small>\n                                    <strong class=\"fs-4 text-dark\" id=\"linearRmse\">--</strong>\n                                    <div class=\"small text-muted\">Root Mean Squared</div>\n                                </div>\n                                <div class=\"col-4 text-center p-2 bg-light rounded\">\n                                    <small class=\"text-muted d-block\">R-Squared (R²)</small>\n                                    <strong class=\"fs-4 text-primary\" id=\"linearR2\">--</strong>\n                                    <div class=\"small text-muted\">Variance Explained</div>\n                                </div>\n                            </div>\n                            <p class=\"small text-muted mt-3 mb-0\">Linear regression struggles with triage queue jumping and doctor fatigue nonlinearity, establishing why Random Forest is superior.</p>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"card-widget mb-4\">\n                    <div class=\"widget-header\">\n                        <h5 class=\"widget-title\"><i class=\"fas fa-ranking-star\"></i> Random Forest Feature Importances (%)</h5>\n                    </div>\n                    <div style=\"height: 270px;\">\n                        <canvas id=\"chartFeatureImportance\"></canvas>\n                    </div>\n                </div>\n\n                <div class=\"card-widget\">\n                    <div class=\"widget-header\">\n                        <h5 class=\"widget-title\"><i class=\"fas fa-spell-check\"></i> Interpretability Breakdown for Evaluator</h5>\n                    </div>\n                    <div class=\"row g-3\">\n                        <div class=\"col-md-4\">\n                            <div class=\"p-3 bg-light rounded\">\n                                <strong class=\"text-dark d-block mb-1\">Dataset Size & Split:</strong>\n                                <span class=\"small text-muted\" id=\"mlDatasetSamples\">--</span>\n                            </div>\n                        </div>\n                        <div class=\"col-md-4\">\n                            <div class=\"p-3 bg-light rounded\">\n                                <strong class=\"text-dark d-block mb-1\">MAE Interpretation:</strong>\n                                <span class=\"small text-muted\" id=\"mlMaeMeaning\">--</span>\n                            </div>\n                        </div>\n                        <div class=\"col-md-4\">\n                            <div class=\"p-3 bg-light rounded\">\n                                <strong class=\"text-dark d-block mb-1\">R-Squared Interpretation:</strong>\n                                <span class=\"small text-muted\" id=\"mlR2Meaning\">--</span>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"table-responsive mt-3\">\n                        <table class=\"table-custom\">\n                            <thead>\n                                <tr>\n                                    <th>Input Feature</th>\n                                    <th>Weight (%)</th>\n                                    <th>Operational Meaning in Queue Prediction</th>\n                                </tr>\n                            </thead>\n                            <tbody id=\"tableFeatureImportance\"></tbody>\n                        </table>\n                    </div>\n                </div>\n            </section>\n\n            <!-- ========================================================================= -->\n            <!-- 14. ABOUT & ARCHITECTURE SECTION -->\n            <!-- ========================================================================= -->\n            <section id=\"section-about\" class=\"dashboard-section\">\n                <div class=\"card-widget mb-4\" style=\"background: linear-gradient(135deg, #0b1a30 0%, #1e3a8a 100%); color: #ffffff;\">\n                    <div class=\"p-3\">\n                        <span class=\"badge bg-info text-dark mb-2\">Hackathon Project Submission</span>\n                        <h2 class=\"fw-bold text-white mb-2\">QUEUE ORACLE</h2>\n                        <h5 class=\"text-info mb-3\">AI-Powered Smart Hospital Queue and Resource Prediction System</h5>\n                        <p class=\"lead\" style=\"font-size: 1.05rem; opacity: 0.9;\">\n                            <em>\"Queue Oracle does not just show what is happening in a hospital. It predicts what could happen next and helps hospitals prepare.\"</em>\n                        </p>\n                    </div>\n                </div>\n\n                <div class=\"row g-3\">\n                    <div class=\"col-lg-6\">\n                        <div class=\"card-widget h-100\">\n                            <h5 class=\"widget-title\"><i class=\"fas fa-layer-group\"></i> Modular Architecture</h5>\n                            <ul class=\"small text-muted mb-0\">\n                                <li><strong>Frontend:</strong> HTML5, CSS3, JavaScript (ES6), Bootstrap 5, Chart.js.</li>\n                                <li><strong>Backend:</strong> Python 3, Flask REST API, CORS.</li>\n                                <li><strong>Machine Learning:</strong> Scikit-Learn Random Forest Regressor, Linear Regression, Moving Average Time-Series.</li>\n                                <li><strong>Database:</strong> SQLite3 with relational foreign keys and transaction integrity.</li>\n                                <li><strong>Persistence:</strong> Models saved as Joblib artifacts (`wait_time_rf.joblib`).</li>\n                            </ul>\n                        </div>\n                    </div>\n                    <div class=\"col-lg-6\">\n                        <div class=\"card-widget h-100\">\n                            <h5 class=\"widget-title\"><i class=\"fas fa-graduation-cap\"></i> 3rd Semester Hackathon Talking Points</h5>\n                            <ol class=\"small text-muted mb-0 ps-3\">\n                                <li><strong>Dynamic Delay Cascade:</strong> When a doctor's consultation runs over by 25 mins, downstream waiting times update automatically.</li>\n                                <li><strong>Intelligent Doctor Rebalancing:</strong> Detects when Doctor A has 16 patients while Doctor B has 3, calculates wait time savings, and executes reassignment upon approval.</li>\n                                <li><strong>Hospital Bed Horizon Forecasting:</strong> Hourly admission vs discharge balancing forecasts saturation 1 to 4 hours in advance.</li>\n                                <li><strong>Epidemiological Surveillance to Inventory Link:</strong> Spikes in Dengue cases immediately flag impending stockouts in NS1 Rapid Kits and IV fluids.</li>\n                            </ol>\n                        </div>\n                    </div>\n                </div>\n            </section>\n        </div>\n    </main>\n</div>\n\n<!-- ========================================================================= -->\n<!-- MODAL: REGISTER PATIENT -->\n<!-- ========================================================================= -->\n<div class=\"modal fade\" id=\"modalRegisterPatient\" tabindex=\"-1\" aria-hidden=\"true\">\n    <div class=\"modal-dialog\">\n        <div class=\"modal-content\">\n            <form id=\"formRegisterPatient\">\n                <div class=\"modal-header\">\n                    <h5 class=\"modal-title fw-bold text-navy\"><i class=\"fas fa-user-plus text-primary\"></i> Register New OPD Patient</h5>\n                    <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\n                </div>\n                <div class=\"modal-body\">\n                    <div class=\"mb-3\">\n                        <label class=\"form-label small fw-bold\">Patient Full Name:</label>\n                        <input type=\"text\" id=\"regPatientName\" class=\"form-control\" placeholder=\"e.g. Ramesh Kulkarni (or leave blank for auto-generate)\">\n                    </div>\n                    <div class=\"mb-3\">\n                        <label class=\"form-label small fw-bold\">Department:</label>\n                        <select id=\"regPatientDept\" class=\"form-select\" required>\n                            <option value=\"General Medicine\">General Medicine</option>\n                            <option value=\"Pediatrics\">Pediatrics</option>\n                            <option value=\"Orthopedics\">Orthopedics</option>\n                            <option value=\"Cardiology\">Cardiology</option>\n                            <option value=\"Emergency\">Emergency</option>\n                            <option value=\"General Surgery\">General Surgery</option>\n                        </select>\n                    </div>\n                    <div class=\"mb-3\">\n                        <label class=\"form-label small fw-bold\">Triage Priority Level:</label>\n                        <select id=\"regPatientPriority\" class=\"form-select\" required>\n                            <option value=\"Normal\">Normal (Routine OPD Queue)</option>\n                            <option value=\"Medium\">Medium (Urgent Consultation)</option>\n                            <option value=\"Emergency\">Emergency (Immediate Intervention)</option>\n                        </select>\n                    </div>\n                    <div class=\"mb-3\">\n                        <label class=\"form-label small fw-bold\">Primary Clinical Reason / Tag:</label>\n                        <select id=\"regPatientDisease\" class=\"form-select\">\n                            <option value=\"General Checkup\">General Checkup</option>\n                            <option value=\"Fever-related\">Fever-related Illness</option>\n                            <option value=\"Dengue\">Suspected Dengue</option>\n                            <option value=\"Malaria\">Suspected Malaria</option>\n                            <option value=\"Seasonal Influenza\">Seasonal Influenza</option>\n                            <option value=\"Hypertension\">Cardiovascular / BP</option>\n                            <option value=\"Respiratory Infection\">Acute Respiratory Infection</option>\n                        </select>\n                    </div>\n                </div>\n                <div class=\"modal-footer\">\n                    <button type=\"button\" class=\"btn btn-secondary\" data-bs-dismiss=\"modal\">Cancel</button>\n                    <button type=\"submit\" class=\"btn btn-primary\"><i class=\"fas fa-check\"></i> Register & Calculate Wait</button>\n                </div>\n            </form>\n        </div>\n    </div>\n</div>\n\n<!-- Toast Container for Notifications -->\n<div id=\"toast-container\"></div>\n\n<!-- Bootstrap 5 JS Bundle -->\n<script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js\"></script>\n<!-- Chart.js 4 JS -->\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js\"></script>\n\n<!-- Application Scripts -->\n<script src=\"{{ url_for('static', filename='js/charts.js') }}\"></script>\n<script src=\"{{ url_for('static', filename='js/simulation.js') }}\"></script>\n<script src=\"{{ url_for('static', filename='js/dashboard.js') }}\"></script>\n\n</body>\n</html>\n","Path":"C:\\Users\\KRUTIKA SHIVANAND\\.gemini\\antigravity\\scratch\\queue-oracle\\templates\\index.html"}}]}
