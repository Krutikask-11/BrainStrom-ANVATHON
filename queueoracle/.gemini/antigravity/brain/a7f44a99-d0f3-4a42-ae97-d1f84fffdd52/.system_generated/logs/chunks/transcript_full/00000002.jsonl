{"step_index":53,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-30T13:53:50Z","input_tokens":12822,"cache_read_tokens":71563,"output_tokens":2459,"thinking":"Section 13 necessitates an interactive simulation engine to facilitate evaluator interaction during the hackathon. The system must enable patient addition, arrival rate manipulation (burst arrivals), priority adjustments, consultation duration modification (including delays), consultation completion, and doctor availability toggling. This set of features seems sufficient for demonstration.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"/**\n * QUEUE ORACLE - Interactive Simulation Engine (Section 13)\n * Provides comprehensive hackathon simulation controls that modify underlying\n * SQLite data and trigger dynamic real-time recalculations across all modules.\n */\n\nfunction loadSimulationControls() {\n    // Populate doctors in simulation selector\n    fetch(\"/api/doctors\")\n        .then(res => res.json())\n        .then(doctors => {\n            const docSelect = document.getElementById(\"simSelectDoctor\");\n            if (docSelect) {\n                docSelect.innerHTML = doctors.map(d => `\n                    <option value=\"${d.id}\">${d.name} (${d.department}) - Room ${d.room_no}</option>\n                `).join(\"\");\n            }\n        });\n}\n\n// 1. Simulate Burst Patient Arrival\nasync function simBurstArrival(count, priority = \"Normal\") {\n    const dept = document.getElementById(\"simSelectDept\")?.value || \"General Medicine\";\n    const docId = document.getElementById(\"simSelectDoctor\")?.value;\n\n    try {\n        const res = await fetch(\"/api/simulation/burst-patients\", {\n            method: \"POST\",\n            headers: { \"Content-Type\": \"application/json\" },\n            body: JSON.stringify({ count, department: dept, priority, doctor_id: docId })\n        });\n        const data = await res.json();\n        if (data.success) {\n            showToast(`Simulation: Burst of +${count} ${priority} patients added! Queues recalculated.`, \"success\");\n            loadOverview();\n        }\n    } catch (err) {\n        showToast(\"Simulation error: \" + err, \"danger\");\n    }\n}\n\n// 2. Simulate Consultation Delay\nasync function simDoctorDelay(delayMinutes) {\n    const docId = document.getElementById(\"simSelectDoctor\")?.value;\n    if (!docId) {\n        showToast(\"Please select a target doctor first.\", \"warning\");\n        return;\n    }\n\n    try {\n        // Find active patient in consultation or first waiting for this doctor\n        const patRes = await fetch(`/api/patients?doctor_id=${docId}`);\n        const patients = await patRes.json();\n        const targetPat = patients.find(p => p.status === \"IN_CONSULTATION\") || patients[0];\n\n        if (!targetPat) {\n            showToast(\"No active patients found for selected doctor to delay.\", \"warning\");\n            return;\n        }\n\n        const res = await fetch(`/api/patients/${targetPat.id}/delay`, {\n            method: \"POST\",\n            headers: { \"Content-Type\": \"application/json\" },\n            body: JSON.stringify({ delay_minutes: delayMinutes })\n        });\n        const data = await res.json();\n        if (data.success) {\n            showToast(`Simulation: Injected +${delayMinutes}m delay on ${targetPat.name}'s consultation! All subsequent patient wait times shifted forward.`, \"warning\");\n            loadOverview();\n            loadQueue();\n        }\n    } catch (err) {\n        showToast(\"Simulation error: \" + err, \"danger\");\n    }\n}\n\n// 3. Simulate Complete Current Consultation\nasync function simCompleteCurrentConsultation() {\n    const docId = document.getElementById(\"simSelectDoctor\")?.value;\n    try {\n        const patRes = await fetch(`/api/patients?doctor_id=${docId}`);\n        const patients = await patRes.json();\n        const inConsult = patients.find(p => p.status === \"IN_CONSULTATION\");\n\n        if (!inConsult) {\n            showToast(\"No patient currently in consultation for selected doctor.\", \"info\");\n            return;\n        }\n\n        const res = await fetch(`/api/patients/${inConsult.id}/status`, {\n            method: \"POST\",\n            headers: { \"Content-Type\": \"application/json\" },\n            body: JSON.stringify({ status: \"COMPLETED\", actual_duration: inConsult.estimated_duration })\n        });\n        const data = await res.json();\n        if (data.success) {\n            showToast(`Simulation: Consultation completed for Token #${inConsult.opd_token}! Remaining queue times updated.`, \"success\");\n            loadOverview();\n            loadQueue();\n        }\n    } catch (err) {\n        showToast(\"Simulation error: \" + err, \"danger\");\n    }\n}\n\n// 4. Simulate Doctor Availability Toggle (Goes on Break / Emergency)\nasync function simToggleDoctorAvail() {\n    const docId = document.getElementById(\"simSelectDoctor\")?.value;\n    if (!docId) return;\n\n    try {\n        const res = await fetch(`/api/doctors/${docId}/availability`, { method: \"POST\" });\n        const data = await res.json();\n        if (data.success) {\n            showToast(`Simulation: ${data.message} Queue recalculation triggered!`, \"warning\");\n            loadOverview();\n            loadDoctors();\n            loadQueue();\n        }\n    } catch (err) {\n        showToast(\"Simulation error: \" + err, \"danger\");\n    }\n}\n\n// 5. Simulate Hospital Bed Admission Surge\nasync function simBedAdmission() {\n    const dept = document.getElementById(\"simSelectBedDept\")?.value || \"Cardiology\";\n    try {\n        const res = await fetch(\"/api/beds/simulate-admit\", {\n            method: \"POST\",\n            headers: { \"Content-Type\": \"application/json\" },\n            body: JSON.stringify({ department: dept })\n        });\n        const data = await res.json();\n        if (data.success) {\n            showToast(`Simulation: ${data.message} Bed occupancy increased!`, \"warning\");\n            loadOverview();\n            loadBeds();\n        } else {\n            showToast(data.message, \"danger\");\n        }\n    } catch (err) {\n        showToast(\"Simulation error: \" + err, \"danger\");\n    }\n}\n\n// 6. Simulate Hospital Bed Discharge\nasync function simBedDischarge() {\n    const dept = document.getElementById(\"simSelectBedDept\")?.value || \"Cardiology\";\n    try {\n        const res = await fetch(\"/api/beds/simulate-discharge\", {\n            method: \"POST\",\n            headers: { \"Content-Type\": \"application/json\" },\n            body: JSON.stringify({ department: dept })\n        });\n        const data = await res.json();\n        if (data.success) {\n            showToast(`Simulation: ${data.message} Available beds increased!`, \"success\");\n            loadOverview();\n            loadBeds();\n        } else {\n            showToast(data.message, \"danger\");\n        }\n    } catch (err) {\n        showToast(\"Simulation error: \" + err, \"danger\");\n    }\n}\n\n// 7. Simulate Disease Outbreak Surge (Dengue / Malaria)\nasync function simDiseaseOutbreak(disease, count) {\n    try {\n        const res = await fetch(\"/api/disease-trends/simulate-surge\", {\n            method: \"POST\",\n            headers: { \"Content-Type\": \"application/json\" },\n            body: JSON.stringify({ disease: disease, additional_cases: count })\n        });\n        const data = await res.json();\n        if (data.success) {\n            showToast(`Simulation: ${data.message} Recalculated epidemiological forecasts & inventory warnings!`, \"danger\");\n            loadOverview();\n            loadDiseaseTrends();\n            loadInventory();\n        }\n    } catch (err) {\n        showToast(\"Simulation error: \" + err, \"danger\");\n    }\n}\n\n// 8. Simulate Inventory Depletion (Force Stockout)\nasync function simDepleteInventory(itemId, qty) {\n    try {\n        const res = await fetch(`/api/inventory/${itemId}/adjust`, {\n            method: \"POST\",\n            headers: { \"Content-Type\": \"application/json\" },\n            body: JSON.stringify({ available_qty: qty })\n        });\n        const data = await res.json();\n        if (data.success) {\n            showToast(`Simulation: Injected inventory depletion to ${qty} units. Shortage alert active!`, \"danger\");\n            loadOverview();\n            loadInventory();\n        }\n    } catch (err) {\n        showToast(\"Simulation error: \" + err, \"danger\");\n    }\n}\n\n// 9. Reset Entire Simulation to Clean Seed\nasync function resetSimulationBaseline() {\n    if (!confirm(\"Are you sure you want to reset hospital operational data back to the clean demonstration baseline?\")) {\n        return;\n    }\n\n    try {\n        const res = await fetch(\"/api/simulation/reset\", { method: \"POST\" });\n        const data = await res.json();\n        if (data.success) {\n            showToast(\"Simulation reset: Database reseeded and models re-synced!\", \"success\");\n            loadOverview();\n            loadPatients();\n            loadQueue();\n            loadDoctors();\n            loadBeds();\n            loadDiseaseTrends();\n            loadInventory();\n            loadRecommendations();\n        }\n    } catch (err) {\n        showToast(\"Error resetting simulation: \" + err, \"danger\");\n    }\n}\n","Path":"C:\\Users\\KRUTIKA SHIVANAND\\.gemini\\antigravity\\scratch\\queue-oracle\\static\\js\\simulation.js"}}]}
{"step_index":54,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-30T13:54:11Z","content":"Created At: 2026-10-30T19:24:11+05:30\nCompleted At: 2026-10-30T19:24:11+05:30\nCreated file."}
{"step_index":55,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-30T13:54:11Z","input_tokens":2562,"cache_read_tokens":84358,"output_tokens":12977,"thinking":"Beginning construction of the `templates/index.html` file, the initial goal is to ensure completeness and correctness of its structure. The navigation sections must have all 14 required parts implemented correctly.\n\nFocusing on the first two sections, `overview` (including KPIs, alerts, department-wise cards, charts, and queue previews) and `patients` (search, filters, register modal, and patient table), verifying their respective components will be critical. The successful construction of these components will validate the architecture.\n\n\nExamining the listed components, the priority shifts to building out the core data display elements for the remaining sections beyond 'overview' and 'patients'. Specifically, I will address `queue`, `prediction`, `doctors`, `forecast`, `beds`, `disease`, `inventory`, `recommendations`, and `insights`. This confirms the structure will have all of the required components implemented.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Queue Oracle - AI-Powered Hospital Queue & Resource Prediction</title>\n    <!-- Bootstrap 5 CSS -->\n    <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\n    <!-- Font Awesome Icons -->\n    <link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\" rel=\"stylesheet\">\n    <!-- Custom CSS -->\n    <link rel=\"stylesheet\" href=\"{{ url_for('static', filename='css/style.css') }}\">\n</head>\n<body>\n\n<div id=\"app-container\">\n    <!-- SIDEBAR NAVIGATION -->\n    <aside id=\"sidebar\">\n        <div class=\"brand-section\">\n            <h1 class=\"brand-title\">\n                <i class=\"fas fa-heart-pulse\"></i>\n                <span>QUEUE ORACLE</span>\n            </h1>\n            <div class=\"brand-subtitle\">AI Smart Hospital Operations</div>\n        </div>\n\n        <ul class=\"sidebar-nav\">\n            <li class=\"nav-header\">Clinical & Queue Operations</li>\n            <li><a class=\"nav-link active\" data-section=\"overview\"><i class=\"fas fa-chart-pie\"></i><span>1. Overview</span></a></li>\n            <li><a class=\"nav-link\" data-section=\"patients\"><i class=\"fas fa-user-injured\"></i><span>2. Patient Management</span></a></li>\n            <li><a class=\"nav-link\" data-section=\"queue\"><i class=\"fas fa-users-line\"></i><span>3. Patient Queue</span></a></li>\n            <li><a class=\"nav-link\" data-section=\"prediction\"><i class=\"fas fa-brain\"></i><span>4. Wait Time Prediction</span></a></li>\n            <li><a class=\"nav-link\" data-section=\"doctors\"><i class=\"fas fa-user-doctor\"></i><span>5. Doctor Workload</span></a></li>\n\n            <li class=\"nav-header\">Resource & Epidemic Forecasting</li>\n            <li><a class=\"nav-link\" data-section=\"forecast\"><i class=\"fas fa-chart-line\"></i><span>6. Resource Forecast</span></a></li>\n            <li><a class=\"nav-link\" data-section=\"beds\"><i class=\"fas fa-bed-pulse\"></i><span>7. Bed Occupancy</span></a></li>\n            <li><a class=\"nav-link\" data-section=\"disease\"><i class=\"fas fa-virus-covid\"></i><span>8. Disease Trends</span></a></li>\n            <li><a class=\"nav-link\" data-section=\"inventory\"><i class=\"fas fa-boxes-stacked\"></i><span>9. Inventory</span></a></li>\n\n            <li class=\"nav-header\">Decision Support & Hackathon</li>\n            <li><a class=\"nav-link\" data-section=\"recommendations\"><i class=\"fas fa-scale-balanced\"></i><span>10. Reassignment</span></a></li>\n            <li><a class=\"nav-link\" data-section=\"insights\"><i class=\"fas fa-clipboard-check\"></i><span>11. Admin Insights</span></a></li>\n            <li><a class=\"nav-link\" data-section=\"simulation\"><i class=\"fas fa-flask\"></i><span>12. Simulation Lab</span><span class=\"badge bg-warning text-dark nav-badge\">Demo</span></a></li>\n            <li><a class=\"nav-link\" data-section=\"ml-performance\"><i class=\"fas fa-microchip\"></i><span>13. ML Performance</span></a></li>\n            <li><a class=\"nav-link\" data-section=\"about\"><i class=\"fas fa-circle-info\"></i><span>14. About & Guide</span></a></li>\n        </ul>\n\n        <div class=\"sidebar-footer\">\n            <div class=\"d-flex align-items-center justify-content-between mb-1\">\n                <span><i class=\"fas fa-circle text-success\" style=\"font-size: 0.6rem;\"></i> Live System</span>\n                <span id=\"live-clock\" class=\"fw-bold\">--:--:--</span>\n            </div>\n            <div class=\"text-muted\" style=\"font-size: 0.68rem;\">Oracle AI Engine v2.4 (Active)</div>\n        </div>\n    </aside>\n\n    <!-- MAIN CONTENT -->\n    <main id=\"main-content\">\n        <!-- TOP NAVBAR -->\n        <header class=\"top-navbar\">\n            <div class=\"d-flex align-items-center gap-3\">\n                <span class=\"fw-bold text-navy\" style=\"font-size: 1.05rem;\">\n                    <i class=\"fas fa-hospital text-primary me-1\"></i> Apex Memorial Teaching Hospital\n                </span>\n                <span class=\"badge bg-light text-dark border\">Central OPD & Wards</span>\n            </div>\n\n            <div class=\"d-flex align-items-center gap-3\">\n                <div class=\"sim-indicator\">\n                    <span class=\"dot\"></span>\n                    <span>Dynamic Recalculation Engine Online</span>\n                </div>\n                <button class=\"btn btn-sm btn-outline-primary\" onclick=\"navigateTo('simulation')\">\n                    <i class=\"fas fa-flask\"></i> Open Simulation\n                </button>\n                <button class=\"btn btn-sm btn-primary\" data-bs-toggle=\"modal\" data-bs-target=\"#modalRegisterPatient\">\n                    <i class=\"fas fa-plus\"></i> Register Patient\n                </button>\n            </div>\n        </header>\n\n        <div class=\"page-container\">\n            <!-- ========================================================================= -->\n            <!-- 1. OVERVIEW SECTION -->\n            <!-- ========================================================================= -->\n            <section id=\"section-overview\" class=\"dashboard-section active\">\n                <div class=\"d-flex justify-content-between align-items-center mb-3\">\n                    <div>\n                        <h4 class=\"fw-bold text-navy mb-0\">Hospital Operations Overview</h4>\n                        <p class=\"text-muted small mb-0\">Real-time patient census, queue latency, and predictive resource metrics.</p>\n                    </div>\n                    <button class=\"btn btn-sm btn-outline-secondary\" onclick=\"loadOverview()\">\n                        <i class=\"fas fa-arrows-rotate\"></i> Refresh Dashboard\n                    </button>\n                </div>\n\n                <!-- Alert Banners -->\n                <div id=\"overviewAlertsBanner\"></div>\n\n                <!-- KPI Metric Cards -->\n                <div class=\"row g-3 mb-3\">\n                    <div class=\"col-xl-2 col-md-4 col-sm-6\">\n                        <div class=\"stat-card blue\">\n                            <div class=\"stat-info\">\n                                <div class=\"stat-label\">Registered Today</div>\n                                <div class=\"stat-value\" id=\"kpiTotalPatients\">0</div>\n                                <div class=\"stat-sub\">Central OPD Intake</div>\n                            </div>\n                            <div class=\"stat-icon blue\"><i class=\"fas fa-id-card\"></i></div>\n                        </div>\n                    </div>\n                    <div class=\"col-xl-2 col-md-4 col-sm-6\">\n                        <div class=\"stat-card yellow\">\n                            <div class=\"stat-info\">\n                                <div class=\"stat-label\">Currently Waiting</div>\n                                <div class=\"stat-value\" id=\"kpiWaitingPatients\">0</div>\n                                <div class=\"stat-sub\">Active waiting queue</div>\n                            </div>\n                            <div class=\"stat-icon yellow\"><i class=\"fas fa-hourglass-half\"></i></div>\n                        </div>\n                    </div>\n                    <div class=\"col-xl-2 col-md-4 col-sm-6\">\n                        <div class=\"stat-card green\">\n                            <div class=\"stat-info\">\n                                <div class=\"stat-label\">In Consultation</div>\n                                <div class=\"stat-value\" id=\"kpiInConsultation\">0</div>\n                                <div class=\"stat-sub\">Inside doctor rooms</div>\n                            </div>\n                            <div class=\"stat-icon green\"><i class=\"fas fa-stethoscope\"></i></div>\n                        </div>\n                    </div>\n                    <div class=\"col-xl-2 col-md-4 col-sm-6\">\n                        <div class=\"stat-card red\">\n                            <div class=\"stat-info\">\n                                <div class=\"stat-label\">Avg Predicted Wait</div>\n                                <div class=\"stat-value\" id=\"kpiAvgWaitTime\">0m</div>\n                                <div class=\"stat-sub\">Random Forest AI</div>\n                            </div>\n                            <div class=\"stat-icon red\"><i class=\"fas fa-clock\"></i></div>\n                        </div>\n                    </div>\n                    <div class=\"col-xl-2 col-md-4 col-sm-6\">\n                        <div class=\"stat-card cyan\">\n                            <div class=\"stat-info\">\n                                <div class=\"stat-label\">Active Doctors</div>\n                                <div class=\"stat-value\" id=\"kpiDoctorsRatio\">0/0</div>\n                                <div class=\"stat-sub\">Available vs on break</div>\n                            </div>\n                            <div class=\"stat-icon cyan\"><i class=\"fas fa-user-md\"></i></div>\n                        </div>\n                    </div>\n                    <div class=\"col-xl-2 col-md-4 col-sm-6\">\n                        <div class=\"stat-card blue\">\n                            <div class=\"stat-info\">\n                                <div class=\"stat-label\">Bed Occupancy</div>\n                                <div class=\"stat-value\" id=\"kpiBedOccupancy\">0%</div>\n                                <div class=\"stat-sub\">All ward capacity</div>\n                            </div>\n                            <div class=\"stat-icon blue\"><i class=\"fas fa-bed\"></i></div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Charts Row -->\n                <div class=\"row g-3 mb-4\">\n                    <div class=\"col-lg-6\">\n                        <div class=\"card-widget h-100\">\n                            <div class=\"widget-header\">\n                                <h5 class=\"widget-title\"><i class=\"fas fa-hospital-user\"></i> Patients Waiting by Department</h5>\n                                <span class=\"badge bg-light text-dark border\">Color Coded by Load</span>\n                            </div>\n                            <div style=\"height: 270px;\">\n                                <canvas id=\"chartDeptWaiting\"></canvas>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"col-lg-6\">\n                        <div class=\"card-widget h-100\">\n                            <div class=\"widget-header\">\n                                <h5 class=\"widget-title\"><i class=\"fas fa-chart-line\"></i> Diurnal Patient Arrivals & AI Projection</h5>\n                                <span class=\"badge bg-primary\">Today's Forecast</span>\n                            </div>\n                            <div style=\"height: 270px;\">\n                                <canvas id=\"chartArrivalsForecast\"></canvas>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Department Operational Cards -->\n                <h5 class=\"fw-bold text-navy mb-2\"><i class=\"fas fa-sitemap text-primary\"></i> Department-Wise Operations & Status</h5>\n                <div class=\"row\" id=\"overviewDeptCards\"></div>\n\n                <!-- Live Queue Preview -->\n                <div class=\"card-widget mt-2\">\n                    <div class=\"widget-header\">\n                        <h5 class=\"widget-title\"><i class=\"fas fa-stream\"></i> Active Queue Activity (Live Triage View)</h5>\n                        <button class=\"btn btn-sm btn-link\" onclick=\"navigateTo('queue')\">Open Doctor Queues <i class=\"fas fa-arrow-right\"></i></button>\n                    </div>\n                    <div class=\"table-responsive\">\n                        <table class=\"table-custom\">\n                            <thead>\n                                <tr>\n                                    <th>Token</th>\n                                    <th>Patient</th>\n                                    <th>Department</th>\n                                    <th>Assigned Doctor</th>\n                                    <th>Priority</th>\n                                    <th>Pred. Wait</th>\n                                    <th>Expected Time</th>\n                                    <th>Status</th>\n                                </tr>\n                            </thead>\n                            <tbody id=\"tableRecentQueue\"></tbody>\n                        </table>\n                    </div>\n                </div>\n            </section>\n\n            <!-- ========================================================================= -->\n            <!-- 2. PATIENT MANAGEMENT SECTION -->\n            <!-- ========================================================================= -->\n            <section id=\"section-patients\" class=\"dashboard-section\">\n                <div class=\"d-flex justify-content-between align-items-center mb-3\">\n                    <div>\n                        <h4 class=\"fw-bold text-navy mb-0\">Patient Management & Registration</h4>\n                        <p class=\"text-muted small mb-0\">Central OPD intake registry and live status monitoring.</p>\n                    </div>\n                    <button class=\"btn btn-primary\" data-bs-toggle=\"modal\" data-bs-target=\"#modalRegisterPatient\">\n                        <i class=\"fas fa-user-plus\"></i> Register New Patient\n                    </button>\n                </div>\n\n                <div class=\"card-widget mb-3\">\n                    <div class=\"row g-2 align-items-center\">\n                        <div class=\"col-md-4\">\n                            <select id=\"filterPatientDept\" class=\"form-select form-select-sm\">\n                                <option value=\"\">All Departments</option>\n                                <option value=\"General Medicine\">General Medicine</option>\n                                <option value=\"Pediatrics\">Pediatrics</option>\n                                <option value=\"Orthopedics\">Orthopedics</option>\n                                <option value=\"Cardiology\">Cardiology</option>\n                                <option value=\"Emergency\">Emergency</option>\n                                <option value=\"General Surgery\">General Surgery</option>\n                            </select>\n                        </div>\n                        <div class=\"col-md-4\">\n                            <select id=\"filterPatientStatus\" class=\"form-select form-select-sm\">\n                                <option value=\"\">All Statuses</option>\n                                <option value=\"WAITING\">WAITING</option>\n                                <option value=\"CALLED\">CALLED</option>\n                                <option value=\"IN_CONSULTATION\">IN_CONSULTATION</option>\n                                <option value=\"COMPLETED\">COMPLETED</option>\n                            </select>\n                        </div>\n                        <div class=\"col-md-4 text-end\">\n                            <button class=\"btn btn-sm btn-outline-secondary\" onclick=\"loadPatients()\">\n                                <i class=\"fas fa-filter\"></i> Apply Filters\n                            </button>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"card-widget\">\n                    <div class=\"table-responsive\">\n                        <table class=\"table-custom\">\n                            <thead>\n                                <tr>\n                                    <th>Token</th>\n                                    <th>Patient</th>\n                                    <th>Department</th>\n                                    <th>Assigned Doctor</th>\n                                    <th>Arrival</th>\n                                    <th>Priority</th>\n                                    <th>Pred. Wait</th>\n                                    <th>Expected Time</th>\n                                    <th>Status</th>\n                                    <th>Action</th>\n                                </tr>\n                            </thead>\n                            <tbody id=\"tablePatientsList\"></tbody>\n                        </table>\n                    </div>\n                </div>\n            </section>\n\n            <!-- ========================================================================= -->\n            <!-- 3. PATIENT QUEUE SECTION -->\n            <!-- ========================================================================= -->\n            <section id=\"section-queue\" class=\"dashboard-section\">\n                <div class=\"d-flex justify-content-between align-items-center mb-3\">\n                    <div>\n                        <h4 class=\"fw-bold text-navy mb-0\">Doctor-Wise Live Queues & Status Tracking</h4>\n                        <p class=\"text-muted small mb-0\">Staff-operated consultation controls with dynamic delay cascading.</p>\n                    </div>\n                    <button class=\"btn btn-sm btn-outline-secondary\" onclick=\"loadQueue()\">\n                        <i class=\"fas fa-sync\"></i> Refresh Queues\n                    </button>\n                </div>\n\n                <div id=\"doctorQueuesContainer\"></div>\n            </section>\n\n            <!-- ========================================================================= -->\n            <!-- 4. WAITING TIME PREDICTION SECTION -->\n            <!-- ========================================================================= -->\n            <section id=\"section-prediction\" class=\"dashboard-section\">\n                <div class=\"mb-3\">\n                    <h4 class=\"fw-bold text-navy mb-0\">AI-Based Patient Waiting Time Prediction</h4>\n                    <p class=\"text-muted small mb-0\">Query individual patient tokens to inspect real-time Random Forest inference and queue calculations.</p>\n                </div>\n\n                <div class=\"card-widget mb-4\">\n                    <form onsubmit=\"event.preventDefault(); lookupToken();\" class=\"row g-2 align-items-center\">\n                        <div class=\"col-md-5\">\n                            <label class=\"form-label small fw-bold text-muted mb-1\">Enter OPD Token # or Patient ID</label>\n                            <input type=\"text\" id=\"inputLookupToken\" class=\"form-control\" placeholder=\"e.g. 101 or PAT-2005\" required>\n                        </div>\n                        <div class=\"col-md-3 align-self-end\">\n                            <button type=\"submit\" class=\"btn btn-primary w-100\">\n                                <i class=\"fas fa-magnifying-glass\"></i> Predict Waiting Time\n                            </button>\n                        </div>\n                    </form>\n                </div>\n\n                <div id=\"predictionResultCard\">\n                    <div class=\"card-widget text-center py-5 text-muted\">\n                        <i class=\"fas fa-brain fa-3x mb-3 text-primary\" style=\"opacity: 0.6;\"></i>\n                        <h5>Search an OPD Token above</h5>\n                        <p class=\"small mb-0\">The system calculates live waiting time using trained Random Forest regression, doctor backlog, and priority order.</p>\n                    </div>\n                </div>\n            </section>\n\n            <!-- ========================================================================= -->\n            <!-- 5. DOCTOR WORKLOAD SECTION -->\n            <!-- ========================================================================= -->\n            <section id=\"section-doctors\" class=\"dashboard-section\">\n                <div class=\"d-flex justify-content-between align-items-center mb-3\">\n                    <div>\n                        <h4 class=\"fw-bold text-navy mb-0\">Doctor Workload Monitoring & Balancing</h4>\n                        <p class=\"text-muted small mb-0\">Tracks individual physician queues, consultations completed, and detects workload bottlenecks.</p>\n                    </div>\n                    <button class=\"btn btn-sm btn-outline-primary\" onclick=\"navigateTo('recommendations')\">\n                        <i class=\"fas fa-scale-balanced\"></i> View Rebalancing Proposals\n                    </button>\n                </div>\n\n                <div class=\"card-widget mb-4\">\n                    <div class=\"widget-header\">\n                        <h5 class=\"widget-title\"><i class=\"fas fa-chart-simple\"></i> Physician Workload Distribution (Active Backlog)</h5>\n                    </div>\n                    <div style=\"height: 280px;\">\n                        <canvas id=\"chartDoctorWorkload\"></canvas>\n                    </div>\n                </div>\n\n                <div class=\"card-widget\">\n                    <div class=\"table-responsive\">\n                        <table class=\"table-custom\">\n                            <thead>\n                                <tr>\n                                    <th>Doctor Name</th>\n                                    <th>Department</th>\n                                    <th>Specialization</th>\n                                    <th>Clinic Room</th>\n                                    <th>Status</th>\n                                    <th>Waiting</th>\n                                    <th>In Consult</th>\n                                    <th>Avg Consult</th>\n                                    <th>Avg Wait</th>\n                                    <th>Workload</th>\n                                    <th>Action</th>\n                                </tr>\n                            </thead>\n                            <tbody id=\"tableDoctorsWorkload\"></tbody>\n                        </table>\n                    </div>\n                </div>\n            </section>\n\n            <!-- ========================================================================= -->\n            <!-- 6. RESOURCE FORECAST SECTION -->\n            <!-- ========================================================================= -->\n            <section id=\"section-forecast\" class=\"dashboard-section\">\n                <div class=\"mb-3\">\n                    <h4 class=\"fw-bold text-navy mb-0\">Resource & Staffing Requirement Forecasting</h4>\n                    <p class=\"text-muted small mb-0\">Diurnal hospital demand projection and clinical staffing recommendations.</p>\n                </div>\n\n                <div class=\"row g-3 mb-4\">\n                    <div class=\"col-lg-6\">\n                        <div class=\"card-widget h-100\">\n                            <div class=\"widget-header\">\n                                <h5 class=\"widget-title\"><i class=\"fas fa-chart-line\"></i> Hourly Patient Arrival Projections</h5>\n                            </div>\n                            <div style=\"height: 260px;\">\n                                <canvas id=\"chartArrivalsForecastCopy\"></canvas>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"col-lg-6\">\n                        <div class=\"card-widget h-100\">\n                            <div class=\"widget-header\">\n                                <h5 class=\"widget-title\"><i class=\"fas fa-clock-rotate-left\"></i> Estimated Wait Time Curve Across Operating Hours</h5>\n                            </div>\n                            <div style=\"height: 260px;\">\n                                <canvas id=\"chartWaitTimeTrends\"></canvas>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"card-widget\">\n                    <div class=\"widget-header\">\n                        <h5 class=\"widget-title\"><i class=\"fas fa-user-nurse\"></i> Department-Wise Staffing Requirements (Section 11)</h5>\n                    </div>\n                    <div class=\"table-responsive\">\n                        <table class=\"table-custom\">\n                            <thead>\n                                <tr>\n                                    <th>Department</th>\n                                    <th>Base Staff</th>\n                                    <th>Active Doctors</th>\n                                    <th>Active Patients</th>\n                                    <th>Patient : Doctor Ratio</th>\n                                    <th>Strain Status</th>\n                                    <th>Staff Recommended</th>\n                                    <th>Administrative Recommendation</th>\n                                </tr>\n                            </thead>\n                            <tbody id=\"tableStaffingForecast\"></tbody>\n                        </table>\n                    </div>\n                </div>\n            </section>\n\n            <!-- ========================================================================= -->\n            <!-- 7. BED OCCUPANCY SECTION -->\n            <!-- ========================================================================= -->\n            <section id=\"section-beds\" class=\"dashboard-section\">\n                <div class=\"d-flex justify-content-between align-items-center mb-3\">\n                    <div>\n                        <h4 class=\"fw-bold text-navy mb-0\">Department-Wise Bed Occupancy & Shortage Prediction</h4>\n                        <p class=\"text-muted small mb-0\">Tracks hospital ward capacities and predicts hourly overflow for +1h, +2h, +3h, +4h.</p>\n                    </div>\n                    <div class=\"btn-group\">\n                        <button class=\"btn btn-sm btn-outline-danger\" onclick=\"simBedAdmission()\">\n                            <i class=\"fas fa-user-plus\"></i> Simulate Admission\n                        </button>\n                        <button class=\"btn btn-sm btn-outline-success\" onclick=\"simBedDischarge()\">\n                            <i class=\"fas fa-user-minus\"></i> Simulate Discharge\n                        </button>\n                    </div>\n                </div>\n\n                <div class=\"row g-3 mb-4\">\n                    <div class=\"col-md-3\">\n                        <div class=\"stat-card blue\">\n                            <div class=\"stat-info\">\n                                <div class=\"stat-label\">Total Beds</div>\n                                <div class=\"stat-value\" id=\"bedKpiTotal\">0</div>\n                                <div class=\"stat-sub\">Across 6 wards</div>\n                            </div>\n                            <div class=\"stat-icon blue\"><i class=\"fas fa-bed\"></i></div>\n                        </div>\n                    </div>\n                    <div class=\"col-md-3\">\n                        <div class=\"stat-card red\">\n                            <div class=\"stat-info\">\n                                <div class=\"stat-label\">Occupied Beds</div>\n                                <div class=\"stat-value\" id=\"bedKpiOccupied\">0</div>\n                                <div class=\"stat-sub\">Currently admitted</div>\n                            </div>\n                            <div class=\"stat-icon red\"><i class=\"fas fa-user-injured\"></i></div>\n                        </div>\n                    </div>\n                    <div class=\"col-md-3\">\n                        <div class=\"stat-card green\">\n                            <div class=\"stat-info\">\n                                <div class=\"stat-label\">Available Beds</div>\n                                <div class=\"stat-value\" id=\"bedKpiAvailable\">0</div>\n                                <div class=\"stat-sub\">Open for admissions</div>\n                            </div>\n                            <div class=\"stat-icon green\"><i class=\"fas fa-check-circle\"></i></div>\n                        </div>\n                    </div>\n                    <div class=\"col-md-3\">\n                        <div class=\"stat-card yellow\">\n                            <div class=\"stat-info\">\n                                <div class=\"stat-label\">Occupancy Rate</div>\n                                <div class=\"stat-value\" id=\"bedKpiRate\">0%</div>\n                                <div class=\"stat-sub\">Threshold Alert: 90%</div>\n                            </div>\n                            <div class=\"stat-icon yellow\"><i class=\"fas fa-percent\"></i></div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"row g-3 mb-4\">\n                    <div class=\"col-lg-4\">\n                        <div class=\"card-widget h-100\">\n                            <div class=\"widget-header\">\n                                <h5 class=\"widget-title\"><i class=\"fas fa-chart-pie\"></i> Bed Capacity Ratio</h5>\n                            </div>\n                            <div style=\"height: 250px;\">\n                                <canvas id=\"chartBedDonut\"></canvas>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"col-lg-8\">\n                        <div class=\"card-widget h-100\">\n                            <div class=\"widget-header\">\n                                <h5 class=\"widget-title\"><i class=\"fas fa-chart-line\"></i> Hourly Bed Capacity Forecast (+1h to +4h)</h5>\n                            </div>\n                            <div style=\"height: 250px;\">\n                                <canvas id=\"chartBedForecast\"></canvas>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"card-widget\">\n                    <div class=\"widget-header\">\n                        <h5 class=\"widget-title\"><i class=\"fas fa-list-check\"></i> Ward Status & Hourly Shortage Forecast (Section 9)</h5>\n                    </div>\n                    <div class=\"table-responsive\">\n                        <table class=\"table-custom\">\n                            <thead>\n                                <tr>\n                                    <th>Department</th>\n                                    <th>Total</th>\n                                    <th>Occupied</th>\n                                    <th>Available</th>\n                                    <th>Current %</th>\n                                    <th>+1 Hour</th>\n                                    <th>+2 Hours</th>\n                                    <th>+3 Hours</th>\n                                    <th>+4 Hours</th>\n                                    <th>Status</th>\n                                    <th>Administrative Action</th>\n                                </tr>\n                            </thead>\n                            <tbody id=\"tableBedOccupancy\"></tbody>\n                        </table>\n                    </div>\n                </div>\n            </section>\n\n            <!-- ========================================================================= -->\n            <!-- 8. DISEASE TRENDS SECTION -->\n            <!-- ========================================================================= -->\n            <section id=\"section-disease\" class=\"dashboard-section\">\n                <div class=\"d-flex justify-content-between align-items-center mb-3\">\n                    <div>\n                        <h4 class=\"fw-bold text-navy mb-0\">Disease Trend & Hospital Preparedness Forecasting</h4>\n                        <p class=\"text-muted small mb-0\">Epidemiological surveillance using Linear Regression and 7-day Moving Averages.</p>\n                    </div>\n                    <div class=\"btn-group\">\n                        <button class=\"btn btn-sm btn-outline-danger\" onclick=\"simDiseaseOutbreak('Dengue', 15)\">\n                            <i class=\"fas fa-mosquito\"></i> Simulate Dengue Spike (+15)\n                        </button>\n                        <button class=\"btn btn-sm btn-outline-warning\" onclick=\"simDiseaseOutbreak('Malaria', 10)\">\n                            <i class=\"fas fa-virus\"></i> Simulate Malaria Spike (+10)\n                        </button>\n                    </div>\n                </div>\n\n                <!-- Surveillance Disclaimer Alert -->\n                <div class=\"alert alert-info py-2 mb-3 d-flex align-items-center gap-2\">\n                    <i class=\"fas fa-shield-halved fa-lg\"></i>\n                    <small><strong>Aggregate Hospital Preparedness Tool:</strong> Analyzes aggregate surveillance patterns for resource planning. Clearly distinguishes medically verified cases from suspected/triaged OPD arrivals. Not a disease diagnosis system.</small>\n                </div>\n\n                <!-- Preparedness Alerts Container -->\n                <div id=\"diseasePreparednessAlerts\"></div>\n\n                <!-- Disease Trend Chart -->\n                <div class=\"card-widget mb-4\">\n                    <div style=\"height: 290px;\">\n                        <canvas id=\"chartDiseaseTrends\"></canvas>\n                    </div>\n                </div>\n\n                <div class=\"card-widget\">\n                    <div class=\"widget-header\">\n                        <h5 class=\"widget-title\"><i class=\"fas fa-table-list\"></i> Communicable Disease Surveillance & Tomorrow's Projections</h5>\n                    </div>\n                    <div class=\"table-responsive\">\n                        <table class=\"table-custom\">\n                            <thead>\n                                <tr>\n                                    <th>Disease Category</th>\n                                    <th>Department</th>\n                                    <th>Today (Verified/Susp)</th>\n                                    <th>Past 7 Days</th>\n                                    <th>Past 30 Days</th>\n                                    <th>7d Trend</th>\n                                    <th>Pattern</th>\n                                    <th>Tomorrow Forecast</th>\n                                    <th>Inventory Preparedness</th>\n                                </tr>\n                            </thead>\n                            <tbody id=\"tableDiseaseTrends\"></tbody>\n                        </table>\n                    </div>\n                </div>\n            </section>\n\n            <!-- ========================================================================= -->\n            <!-- 9. INVENTORY SECTION -->\n            <!-- ========================================================================= -->\n            <section id=\"section-inventory\" class=\"dashboard-section\">\n                <div class=\"d-flex justify-content-between align-items-center mb-3\">\n                    <div>\n                        <h4 class=\"fw-bold text-navy mb-0\">Inventory & Medicine Preparedness Module</h4>\n                        <p class=\"text-muted small mb-0\">Diagnostic test kits, IV fluids, and supplies linked with disease surges.</p>\n                    </div>\n                    <button class=\"btn btn-sm btn-outline-secondary\" onclick=\"loadInventory()\">\n                        <i class=\"fas fa-arrows-rotate\"></i> Refresh Stock\n                    </button>\n                </div>\n\n                <div class=\"card-widget mb-4\">\n                    <div class=\"widget-header\">\n                        <h5 class=\"widget-title\"><i class=\"fas fa-boxes-packing\"></i> Available Stock vs Safety Thresholds</h5>\n                    </div>\n                    <div style=\"height: 270px;\">\n                        <canvas id=\"chartInventory\"></canvas>\n                    </div>\n                </div>\n\n                <div class=\"card-widget\">\n                    <div class=\"table-responsive\">\n                        <table class=\"table-custom\">\n                            <thead>\n                                <tr>\n                                    <th>Item Name</th>\n                                    <th>Category</th>\n                                    <th>Available Qty</th>\n                                    <th>Min Stock</th>\n                                    <th>Daily Usage</th>\n                                    <th>Days of Cover</th>\n                                    <th>Disease Association</th>\n                                    <th>Shortage Risk</th>\n                                    <th>Replenish Qty</th>\n                                    <th>Action</th>\n                                </tr>\n                            </thead>\n                            <tbody id=\"tableInventory\"></tbody>\n                        </table>\n                    </div>\n                </div>\n            </section>\n\n            <!-- ========================================================================= -->\n            <!-- 10. REASSIGNMENT RECOMMENDATIONS SECTION -->\n            <!-- ========================================================================= -->\n            <section id=\"section-recommendations\" class=\"dashboard-section\">\n                <div class=\"d-flex justify-content-between align-items-center mb-3\">\n                    <div>\n                        <h4 class=\"fw-bold text-navy mb-0\">Intelligent Doctor Workload Balancing (Section 8)</h4>\n                        <p class=\"text-muted small mb-0\">Automatic bottleneck detection and candidate patient redistribution proposals requiring administrator approval.</p>\n                    </div>\n                    <button class=\"btn btn-sm btn-outline-secondary\" onclick=\"loadRecommendations()\">\n                        <i class=\"fas fa-sync\"></i> Re-Scan Queues\n                    </button>\n                </div>\n\n                <div id=\"recommendationsListContainer\"></div>\n            </section>\n\n            <!-- ========================================================================= -->\n            <!-- 11. ADMINISTRATOR INSIGHTS SECTION -->\n            <!-- ========================================================================= -->\n            <section id=\"section-insights\" class=\"dashboard-section\">\n                <div class=\"d-flex justify-content-between align-items-center mb-3\">\n                    <div>\n                        <h4 class=\"fw-bold text-navy mb-0\">Administrator Decision Support Module (Section 12)</h4>\n                        <p class=\"text-muted small mb-0\">Consolidated actionable intelligence: doctor imbalances, bed shortages, disease spikes, inventory alerts.</p>\n                    </div>\n                    <button class=\"btn btn-sm btn-outline-secondary\" onclick=\"loadInsights()\">\n                        <i class=\"fas fa-sync\"></i> Refresh Insights\n                    </button>\n                </div>\n\n                <div id=\"insightsListContainer\"></div>\n            </section>\n\n            <!-- ========================================================================= -->\n            <!-- 12. SIMULATION LAB SECTION -->\n            <!-- ========================================================================= -->\n            <section id=\"section-simulation\" class=\"dashboard-section\">\n                <div class=\"d-flex justify-content-between align-items-center mb-3\">\n                    <div>\n                        <h4 class=\"fw-bold text-navy mb-0\">Interactive Demonstration Simulation Lab (Section 13)</h4>\n                        <p class=\"text-muted small mb-0\">Perform real-time operational perturbations to demonstrate live machine learning dynamic recalculations.</p>\n                    </div>\n                    <button class=\"btn btn-danger\" onclick=\"resetSimulationBaseline()\">\n                        <i class=\"fas fa-rotate-left\"></i> Reset Simulation to Baseline\n                    </button>\n                </div>\n\n                <div class=\"row g-3\">\n                    <!-- Patient Queue Perturbations -->\n                    <div class=\"col-lg-6\">\n                        <div class=\"card-widget h-100\">\n                            <h5 class=\"widget-title mb-3\"><i class=\"fas fa-users-line\"></i> Patient Queue & Doctor Load Simulator</h5>\n                            \n                            <div class=\"mb-3\">\n                                <label class=\"form-label small fw-bold\">Select Target Physician:</label>\n                                <select id=\"simSelectDoctor\" class=\"form-select form-select-sm\"></select>\n                            </div>\n\n                            <div class=\"mb-3\">\n                                <label class=\"form